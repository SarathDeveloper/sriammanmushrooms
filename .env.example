# Copy to .env and fill in. Never commit the real .env.
# lib/env.ts validates these at server start; production refuses to start
# when a required value is missing.

# --- Required -------------------------------------------------------------
# Runtime connection. On Vercel use the provider's POOLED URL (pgbouncer /
# "transaction" mode), e.g. Supabase port 6543 or Neon "-pooler" host.
DATABASE_URL="postgresql://user:password@host:5432/db"
# Direct (non-pooled) URL used only by the Prisma CLI for migrations.
DIRECT_URL="postgresql://user:password@host:5432/db"
# openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Every product image renders through Cloudinary.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Admin image uploads ----------------------------------------------------
# The API key is read in the browser by next-cloudinary (not secret).
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_API_SECRET=""

# --- Monitoring (optional) --------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Online ordering (off unless "true"; needs a rebuild to change) ---------
NEXT_PUBLIC_ORDERS_ENABLED="false"
# Required only when ordering is on:
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
APP_BASE_URL="https://vellimalaifarms.in"

# --- Optional tuning --------------------------------------------------------
# Connections per server instance (defaults: 2 during build, 3 on Vercel,
# 10 on other production hosts, 5 in development).
# DATABASE_POOL_MAX=3
